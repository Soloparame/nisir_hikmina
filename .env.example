NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase also shows this name in newer dashboards — either works:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- Admin appointment alerts (after patient submits /book) ---
# Email (recommended): https://resend.com — create API key, add to hosting + .env.local
RESEND_API_KEY=
# Optional; default uses Resend onboarding sender (works for testing)
# RESEND_FROM_EMAIL=Nisir Health <onboarding@resend.dev>

# Optional overrides (defaults match main admin contacts)
# ADMIN_NOTIFY_EMAIL=fisihaguade2127@gmail.com
# ADMIN_NOTIFY_TELEGRAM=@NisirAd
# ADMIN_NOTIFY_WHATSAPP_E164=251947018285

# Telegram bot (optional): @BotFather → token; message your bot /start → getUpdates for chat_id
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# WhatsApp via CallMeBot (optional): https://www.callmebot.com/blog/free-api-whatsapp-messages/
# CALLMEBOT_API_KEY=
