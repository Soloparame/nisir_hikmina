NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public site URL (used in doctor welcome emails — no trailing slash)
NEXT_PUBLIC_SITE_URL=https://eaglemedicalcare.com

# Use ONE of these (from Supabase → Project Settings → API):
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: bypass RLS for admin server actions (Supabase → Settings → API → service_role)
# SUPABASE_SERVICE_ROLE_KEY=

# --- Email via Brevo (https://www.brevo.com) — doctor welcome, password reset, appointment alerts ---
# API key: Brevo → SMTP & API → API keys (starts with xkeysib-)
BREVO_API_KEY=
# Must be a verified sender (or on a verified domain) in Brevo → Senders
BREVO_FROM_EMAIL=noreply@eaglemedicalcare.com
# Optional display name (defaults to "Eagle Medical")
# BREVO_FROM_NAME=Eagle Medical

# Optional: doctors WhatsApp group link in welcome email (default is Eagle Medical group)
# DOCTOR_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/BVcdM8SO8Ch7FOzUA1RXrK?mode=gi_t

# Optional overrides (defaults match main admin contacts)
# ADMIN_NOTIFY_EMAIL=fisihaguade2127@gmail.com
# ADMIN_NOTIFY_TELEGRAM=@NisirAd
# ADMIN_NOTIFY_WHATSAPP_E164=251947018285

# Telegram bot (optional): @BotFather → token; message your bot /start → getUpdates for chat_id
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# WhatsApp via CallMeBot (optional): https://www.callmebot.com/blog/free-api-whatsapp-messages/
# CALLMEBOT_API_KEY=
